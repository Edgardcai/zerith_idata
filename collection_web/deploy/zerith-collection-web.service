[Unit]
Description=Independent ZERITH Data Collection Website (8090)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/robot/collection_web
ExecStart=/home/robot/collection_web/start.sh --host 0.0.0.0 --port 8090
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true

[Install]
WantedBy=default.target
