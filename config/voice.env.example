# Copy to /home/robot/.config/zerith/voice.env and chmod 600.
# Never commit the populated file.

# Optional proxy for remote LLM/STT/TTS APIs.
# HTTP_PROXY=http://proxy.example:7897
# HTTPS_PROXY=http://proxy.example:7897
# ALL_PROXY=http://proxy.example:7897
NO_PROXY=localhost,127.0.0.1,::1

# Either configure API profiles here or keep using /home/robot/api.txt.
XIAODA_FALLBACK_BASE_URL=https://api.example.com/v1
XIAODA_FALLBACK_API_KEY=replace_me
XIAODA_AUDIO_BASE_URL=https://api.example.com/v1
XIAODA_AUDIO_API_KEY=replace_me

# Robot audio and local Chinese speech routing.
XIAODA_MIC_DEVICE=pipewire
XIAODA_SPEAKER_DEVICE=pipewire
XIAODA_END_SILENCE_SECONDS=0.5
CHINESE_SPEECH_ENABLED=true
CHINESE_ASR_FINAL_TIMEOUT_MS=1500
CHINESE_ASR_ENDPOINT_MS=500
CHINESE_TTS_SPEAKER=Serena
